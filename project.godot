; Engine configuration file.

config_version=5

[application]

config/name="Hisar"
config/description="Hisar - Fortress Defense: a low-poly 3D tower defense. Hold a seaside fortress for 15 waves."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/logo.png"
boot_splash/bg_color=Color(0.96, 0.86, 0.71, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Loc="*res://scripts/autoload/loc.gd"
Sound="*res://scripts/autoload/sound.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/energy_saving/keep_screen_on=true

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=6

